generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// Resultado de cada homologación con su informe (RN-11: cada decisión explicada).
model Homologacion {
  id             Int      @id @default(autoincrement())
  codigoAprobada String
  codigoNueva    String
  nota           Float?
  anio           Int?
  resultado      String // Homologable, No homologable o Pendiente
  porcentaje     Float // coincidencia de contenidos según el agente
  informe        String   @db.NVarChar(Max) // informe completo en JSON
  fecha          DateTime @default(now())
}
