generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// Solicitud de cambio de carrera de un estudiante (HU-04; otra universidad: HU-16)
model Solicitud {
  id                    Int                  @id @default(autoincrement())
  usuarioId             Int
  tipo                  String               @default("INTERNO") // INTERNO (UTA) o EXTERNO (otra universidad)
  carreraOrigen         String               // INTERNO: código (TI). EXTERNO: nombre escrito por el estudiante
  carreraDestino        String               // SW
  periodo               String               // NOVIEMBRE 2026 - MARZO 2027
  estado                String               @default("BORRADOR") // BORRADOR, ENVIADA, RESULTADO_LISTO
  creada                DateTime             @default(now())
  // Solo para EXTERNO (T37)
  universidadOrigen     String?
  periodosAprobados     Int?                 // RN-08: al menos 2
  documentosLegalizados Boolean              @default(false) // RN-08
  mallaId               Int?                 // id del PDF en ms-documentos
  recordId              Int?                 // id del PDF en ms-documentos
  requisitos            String?              @db.NVarChar(Max) // resultado de RN-08 en JSON (T45)
  materias              AsignaturaAprobada[]
}

// Materia aprobada que el estudiante registra en su solicitud (HU-05)
model AsignaturaAprobada {
  id          Int       @id @default(autoincrement())
  solicitudId Int
  codigo      String    // código del catálogo, carrera de origen
  nombre      String
  nivel       String
  paralelo    String
  docente     String
  periodo     String
  anio        Int       // año de aprobación (RN-05)
  nota        Float
  matricula   Int       // 1, 2 o 3
  resultado   String?   // Homologable, No homologable, Pendiente, Sin materia equivalente
  codigoNueva String?
  informe     String?   @db.NVarChar(Max)
  // Solo para materias de otra universidad (T38 y T41)
  creditos     Int?
  horas        Int?
  notaOriginal Float?    // la nota como la puso su universidad (16); en nota queda la convertida (8)
  escala       Int?      // 10, 20 o 100
  silaboId     Int?      // id del sílabo en ms-documentos
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@unique([solicitudId, codigo])
}
