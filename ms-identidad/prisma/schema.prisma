generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  correo    String   @unique
  claveHash String   // la contraseña nunca se guarda tal cual
  rol       String   @default("ESTUDIANTE") // ESTUDIANTE, EXTERNO, ADMIN
  creado    DateTime @default(now())
}