# Copia este archivo como .env (en la misma carpeta que docker-compose.yml) y llena la clave.
# El archivo .env NO se sube a GitHub.

# Proveedor de IA para comparar contenidos (todos tienen opción gratuita):
#   gemini -> Google Gemini. Clave gratis, sin tarjeta: https://aistudio.google.com/apikey
#   groq   -> Groq (Llama 3.3). Clave gratis, sin tarjeta: https://console.groq.com/keys
#   ollama -> Ollama instalado en la PC (https://ollama.com), sin clave y sin internet
#   claude -> API de Claude (Anthropic), de pago. Clave: https://console.anthropic.com (empieza con "sk-ant-")
IA_PROVEEDOR=gemini

# Clave del proveedor (Gemini empieza con "AIza", Groq con "gsk_", Claude con "sk-ant-"). Ollama no necesita.
# Sin clave el sistema funciona, pero el resultado sale "Pendiente" porque falta el análisis de contenidos.
IA_API_KEY=

# Opcional: otro modelo. Vacío = gemini-flash-latest / llama-3.3-70b-versatile / qwen2.5:7b / claude-sonnet-5-5
# (con Claude, claude-haiku-5-5 es más barato)
IA_MODELO=
